AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=

# Auth — generate a strong random value for SECRET_KEY in production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized Redirect URI in your Google Cloud Console OAuth app
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Only needed when running outside Docker (Docker sets these automatically)
# DATABASE_URL=postgresql://bioview:bioview@localhost:5432/bioview
# QDRANT_URL=http://localhost:6333

# Optional: Qdrant Cloud API key (leave empty for local)
# QDRANT_API_KEY=
