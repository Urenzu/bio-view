# ── Required for the API to serve traffic ────────────────────────────────────

# OpenAI — embeddings (text-embedding-3-small) for query + ingest
OPENAI_API_KEY=

# OpenRouter — LLM for /ask streaming
OPENROUTER_API_KEY=

# Postgres with pgvector. Locally docker-compose injects this; on Railway link
# the pgvector plugin and Railway sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Auth — generate a strong random value:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google OAuth — must match an Authorized Redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback


# ── Required only when running ingest (S3 reads of bioRxiv/medRxiv) ──────────
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1


# ── Optional overrides ───────────────────────────────────────────────────────
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_DIM=1536
# GEN_MODEL_ID=qwen/qwen3-30b-a3b-instruct-2507
# EARLIEST_YEAR=2026
# POLL_CRON=0 6 1 * *
# JATS_CACHE_PATH=/tmp/bio-view/jats
# MECA_TEMP_PATH=/tmp/bio-view/meca_tmp
